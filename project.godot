; NEON DRIFT — a self-contained Godot 4 game
config_version=5

[application]
config/name="NEON DRIFT"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Three-sector rescue campaign with distinct ships, evolving weapons, relic choices, permanent progression and legacy save support."
config/icon="res://assets/neon_drift_icon.png"
boot_splash/image="res://assets/neon_drift_splash.png"
boot_splash/bg_color=Color(0.027451, 0.062745, 0.12549, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/size/min_width=800
window/size/min_height=450
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.022, 0.033, 0.075, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
